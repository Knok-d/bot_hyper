# Скопируйте в .env и заполните
TELEGRAM_TOKEN=123456:ABC-your-bot-token
MY_CHAT_ID=123456789

# Минимальный размер позиции в USD для уведомлений (0 = все)
MIN_POSITION_USD=0

# Порог агрегации сделок в USD (мелкие fills копятся и шлются одним сообщением)
# FILL_AGG_THRESHOLD=50000

# Опционально:
# DB_PATH=./data.db
# LOG_PATH=./bot.log
