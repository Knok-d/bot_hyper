# Скопируйте в .env и заполните
TELEGRAM_TOKEN=123456:ABC-your-bot-token

# Chat_id админа бота (расширенная команда /admin; при миграции со старой
# версии — владелец существующих кошельков). Узнать: @userinfobot
ADMIN_CHAT_ID=123456789

# Дефолты для новых юзеров (каждый может переопределить в /settings):
# Минимальный размер позиции в USD для уведомлений (0 = все)
MIN_POSITION_USD=10000
# Порог агрегации сделок в USD (мелкие fills копятся и шлются одним сообщением)
FILL_AGG_THRESHOLD=50000

# Лимит кошельков на одного юзера
# MAX_WALLETS_PER_USER=10

# Опционально:
# DB_PATH=./data.db
# LOG_PATH=./bot.log
